# Model Provider Configuration
# Options: openai, ollama
MODEL_PROVIDER=openai

# Model name - use whatever model you have installed
# OpenAI examples: gpt-4o-mini, gpt-4o, gpt-4-turbo
# Ollama examples: use output from `ollama list`
OPENAI_MODEL=gpt-4o-mini

# OpenAI API Key (required for MODEL_PROVIDER=openai)
OPENAI_API_KEY=your-api-key-here

# Ollama Base URL (optional - defaults to localhost:11434)
# Only needed if running url-agent in Docker or Ollama on different host
# OLLAMA_BASE_URL=http://localhost:11434/v1
